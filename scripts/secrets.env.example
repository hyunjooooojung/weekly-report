# 로컬 실행용 시크릿. 이 파일을 secrets.env 로 복사해 값을 채우세요 (gitignore 됨).
#   cp scripts/secrets.env.example scripts/secrets.env
#
# GitHub Secrets 에 넣었던 값과 동일합니다.
# ⚠️ ANTHROPIC_API_KEY 는 필요 없습니다 — 로컬 요약은 claude CLI 구독 인증을 씁니다.

# flunti/oiia 커밋 읽기용 PAT
export GH_API_TOKEN=""

# obsidian(MyObsidian) 레포 쓰기용 PAT
export VAULT_REPO_TOKEN=""

# Confluence 인증 (이메일 + API 토큰)
export CONFLUENCE_EMAIL=""
export CONFLUENCE_API_TOKEN=""
